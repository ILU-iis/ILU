<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Mascot Image Top -->
    <ImageView
        android:id="@+id/ivWidgetMascot"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:contentDescription="ILU Mascot"
        android:src="@drawable/mascot_cheerful" />

    <!-- Content Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title / Time Greeting -->
        <TextView
            android:id="@+id/tvWidgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat pagi! 🌅 Ada 3 hal baik apa hari ini?"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Subtitle / Invitation -->
        <TextView
            android:id="@+id/tvWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Yuk cerita dan awali harimu bareng ILU 🌻"
            android:textColor="#7A7A7A"
            android:gravity="center"
            android:textSize="10sp" />

        <!-- Action Button Pill -->
        <TextView
            android:id="@+id/btnWidgetAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_primary_3d"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Curhat Sama ILU 💬"
            android:textColor="#1A1A1A"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>