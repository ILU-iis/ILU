<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/card_yellow_pastel"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWidgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#2D2D2D"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Gratitude Terakhir"
            android:textStyle="bold"
            android:textColor="#E6B800"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvWidgetGratitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum ada gratitude."
            android:textColor="#2D2D2D"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ketuk untuk membuka ILU"
            android:textColor="#777777"
            android:textSize="11sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/ivWidgetMascot"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:contentDescription="ILU Mascot"
        android:src="@drawable/mascot_cheerful" />

</LinearLayout>
