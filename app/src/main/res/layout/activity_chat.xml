<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <RelativeLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_avatar_circle"
            android:padding="2dp">

            <ImageView
                android:id="@+id/ivMascotHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Mascot Avatar"
                android:src="@drawable/mascot_welcoming" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ILU"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Teman curhat harianmu 🌻"
                android:textColor="#8C8C8C"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnRecap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/card_yellow_pastel"
            android:elevation="2dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Rekap 📖"
            android:textColor="#E68A00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFEAA7" />

    <!-- RECYCLER VIEW CHAT -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

    <!-- TYPING INDICATOR -->
    <LinearLayout
        android:id="@+id/layoutTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="8dp"
            android:contentDescription="ILU Avatar"
            android:src="@drawable/mascot_welcoming" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_bubble_bot"
            android:elevation="1dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•  •  •"
                android:textColor="#F5A623"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- INPUT AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/card_yellow_pastel"
            android:hint="Ceritakan harimu..."
            android:inputType="textShortMessage"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#1A1A1A"
            android:textColorHint="#999999"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_circle"
            android:contentDescription="Kirim"
            android:elevation="2dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:rotation="180" />

    </LinearLayout>

</LinearLayout>