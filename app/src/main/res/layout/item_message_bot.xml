<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- Small Mascot avatar on the left of bot message -->
    <ImageView
        android:id="@+id/ivBotAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/mascot_welcoming"
        android:layout_gravity="bottom"
        android:layout_marginEnd="6dp"
        android:contentDescription="ILU Avatar" />

    <TextView
        android:id="@+id/tvMessageBot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:text="Pesan ILU"
        android:textColor="#2D2D2D"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:background="@drawable/chat_bubble_bot"
        android:lineSpacingMultiplier="1.1" />

</LinearLayout>
